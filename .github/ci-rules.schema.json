{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CI rules",
  "type": "object",
  "required": [
    "description",
    "full",
    "files",
    "groups",
    "conditions",
    "jobs",
    "browser"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "What the rule does and why. The run summary prints it as the reason a job runs."
    },
    "full": {
      "type": "object",
      "required": [
        "description",
        "events",
        "labels"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "What the rule does and why. The run summary prints it as the reason a job runs."
        },
        "events": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "GitHub Actions events that run everything"
        },
        "labels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Pull request labels that run everything"
        }
      },
      "additionalProperties": false
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "description",
          "paths",
          "class"
        ],
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1,
            "description": "What the rule does and why. The run summary prints it as the reason a job runs."
          },
          "paths": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Repository paths: `*` within a path segment, `**` across segments."
          },
          "except": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Repository paths: `*` within a path segment, `**` across segments."
          },
          "class": {
            "anyOf": [
              {
                "type": "string",
                "const": "lockfile"
              },
              {
                "type": "string",
                "const": "full"
              },
              {
                "type": "string",
                "const": "docs"
              },
              {
                "type": "string",
                "const": "checks"
              },
              {
                "type": "string",
                "const": "code"
              }
            ],
            "description": "lockfile (package-lock.json, Cargo.lock): code for the workspaces and crates whose resolved dependencies changed; full when the root package’s own dependencies changed, or there is no earlier version to compare. full: run everything. docs: documentation; checks instead when a crate or generator reads it. checks: the Linux checks alone, which run every crate's tests and generator's check. code: touches the workspace or crate containing the file and those reading it by path; with none, the Linux checks alone."
          }
        },
        "additionalProperties": false
      },
      "minItems": 1,
      "description": "Each changed file’s class: the first rule whose paths match it, or, when none does, code if a workspace or crate contains it or anything reads it, and full otherwise"
    },
    "groups": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": {
          "type": "object",
          "required": [
            "description",
            "include"
          ],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1,
              "description": "What the rule does and why. The run summary prints it as the reason a job runs."
            },
            "include": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "description": "A glob of workspace and crate directories, or `@name`: another group"
                  },
                  {
                    "type": "object",
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "anyOf": [
                          {
                            "type": "string",
                            "const": "crate"
                          },
                          {
                            "type": "string",
                            "const": "npm"
                          }
                        ]
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": [
                      "facts"
                    ],
                    "properties": {
                      "facts": {
                        "anyOf": [
                          {
                            "type": "string",
                            "const": "coverage"
                          },
                          {
                            "type": "string",
                            "const": "harnessRenderers"
                          }
                        ]
                      }
                    },
                    "additionalProperties": false
                  }
                ],
                "description": "A glob, `@group`, {\"kind\": \"crate\" | \"npm\"}, or {\"facts\": …}: The crates `npm run test:rust:coverage` measures; The renderers the renderer harness tests: packages/renderers/<name> with a scenarios.json"
              },
              "minItems": 1
            },
            "exclude": {
              "type": "array",
              "items": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "description": "A glob of workspace and crate directories, or `@name`: another group"
                  },
                  {
                    "type": "object",
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "anyOf": [
                          {
                            "type": "string",
                            "const": "crate"
                          },
                          {
                            "type": "string",
                            "const": "npm"
                          }
                        ]
                      }
                    },
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "required": [
                      "facts"
                    ],
                    "properties": {
                      "facts": {
                        "anyOf": [
                          {
                            "type": "string",
                            "const": "coverage"
                          },
                          {
                            "type": "string",
                            "const": "harnessRenderers"
                          }
                        ]
                      }
                    },
                    "additionalProperties": false
                  }
                ],
                "description": "A glob, `@group`, {\"kind\": \"crate\" | \"npm\"}, or {\"facts\": …}: The crates `npm run test:rust:coverage` measures; The renderers the renderer harness tests: packages/renderers/<name> with a scenarios.json"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "description": "Named sets of workspaces and crates"
    },
    "conditions": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": {
          "type": "object",
          "required": [
            "description",
            "when"
          ],
          "properties": {
            "description": {
              "type": "string",
              "minLength": 1,
              "description": "What the rule does and why. The run summary prints it as the reason a job runs."
            },
            "when": {
              "$ref": "#/$defs/When"
            }
          },
          "additionalProperties": false
        }
      },
      "description": "Named conditions, which `{\"if\": name}` refers to"
    },
    "jobs": {
      "type": "object",
      "patternProperties": {
        "^[a-z][a-z0-9-]*$": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "description",
                "when"
              ],
              "properties": {
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "description": "What the rule does and why. The run summary prints it as the reason a job runs."
                },
                "when": {
                  "$ref": "#/$defs/When"
                }
              },
              "additionalProperties": false
            },
            {
              "type": "object",
              "required": [
                "description",
                "matrix"
              ],
              "properties": {
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "description": "What the rule does and why. The run summary prints it as the reason a job runs."
                },
                "matrix": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "name",
                      "description",
                      "when",
                      "with"
                    ],
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1,
                        "description": "The entry's name: the check is `<job> (<name>)`"
                      },
                      "description": {
                        "type": "string",
                        "minLength": 1,
                        "description": "What the rule does and why. The run summary prints it as the reason a job runs."
                      },
                      "when": {
                        "$ref": "#/$defs/When"
                      },
                      "with": {
                        "type": "object",
                        "patternProperties": {
                          "^.*$": {
                            "type": "string"
                          }
                        },
                        "description": "The matrix values the job reads, such as `os`"
                      }
                    },
                    "additionalProperties": false
                  },
                  "minItems": 1
                }
              },
              "additionalProperties": false,
              "description": "A matrix job: the entries whose `when` holds, as `include` objects of `name` and `with`"
            }
          ]
        }
      },
      "description": "The jobs of .github/workflows/ci.yml the plan gates, by job ID"
    },
    "browser": {
      "type": "object",
      "required": [
        "description",
        "suites"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "description": "What the rule does and why. The run summary prints it as the reason a job runs."
        },
        "suites": {
          "type": "object",
          "patternProperties": {
            "^.*$": {
              "type": "object",
              "required": [
                "description"
              ],
              "properties": {
                "description": {
                  "type": "string",
                  "minLength": 1,
                  "description": "What the rule does and why. The run summary prints it as the reason a job runs."
                },
                "when": {
                  "$ref": "#/$defs/When"
                },
                "shards": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "object",
                      "patternProperties": {
                        "^.*$": {
                          "type": "integer",
                          "minimum": 1
                        }
                      }
                    }
                  ],
                  "description": "Jobs to shard the suite across: a number, or a number per Playwright project"
                },
                "macos": {
                  "type": "object",
                  "patternProperties": {
                    "^.*$": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "description": "Shards per project on macOS"
                },
                "narrow": {
                  "type": "object",
                  "required": [
                    "description",
                    "group"
                  ],
                  "properties": {
                    "description": {
                      "type": "string",
                      "minLength": 1,
                      "description": "What the rule does and why. The run summary prints it as the reason a job runs."
                    },
                    "group": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9-]*$"
                    }
                  },
                  "additionalProperties": false,
                  "description": "When the suite runs only because of changes to some of the group's members (not all), leave the others' tests out"
                }
              },
              "additionalProperties": false,
              "description": "A browser suite runs when the change reaches it or a workspace its test:browser script builds, and when its own `when` holds"
            }
          },
          "description": "Browser suites by workspace directory; those without `shards` run together in `browser (rest)`"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "When": {
      "anyOf": [
        {
          "type": "string",
          "const": "always",
          "description": "Every pull request, whatever changed: for jobs that check the whole repository cheaply"
        },
        {
          "type": "string",
          "const": "never",
          "description": "Only in full runs"
        },
        {
          "type": "string",
          "const": "docsOnly",
          "description": "Every changed file is documentation"
        },
        {
          "type": "object",
          "required": [
            "if"
          ],
          "properties": {
            "if": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "additionalProperties": false,
          "description": "A named condition holds"
        },
        {
          "type": "object",
          "required": [
            "changes"
          ],
          "properties": {
            "changes": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "Repository paths: `*` within a path segment, `**` across segments."
                },
                {
                  "type": "object",
                  "required": [
                    "facts"
                  ],
                  "properties": {
                    "facts": {
                      "type": "string",
                      "const": "mutants"
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          },
          "additionalProperties": false,
          "description": "A changed file's path matches, whatever its class; {\"facts\": \"mutants\"}: The files .cargo/mutants.toml examines (examine_globs, without exclude_globs)"
        },
        {
          "type": "object",
          "required": [
            "touches"
          ],
          "properties": {
            "touches": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "additionalProperties": false,
          "description": "A workspace or crate in the group is touched: it contains, builds in or reads (tests included) a changed file"
        },
        {
          "type": "object",
          "required": [
            "reaches"
          ],
          "properties": {
            "reaches": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "additionalProperties": false,
          "description": "A workspace or crate in the group is reached: touched, or depending on one that contains or builds in a changed file (a crate whose tests alone read a file is touched, but its dependants are not reached through it)"
        },
        {
          "type": "object",
          "required": [
            "any"
          ],
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/When"
              },
              "minItems": 1
            }
          },
          "additionalProperties": false,
          "description": "Any of these holds"
        },
        {
          "type": "object",
          "required": [
            "not"
          ],
          "properties": {
            "not": {
              "$ref": "#/$defs/When"
            }
          },
          "additionalProperties": false,
          "description": "This does not hold"
        }
      ]
    }
  }
}
