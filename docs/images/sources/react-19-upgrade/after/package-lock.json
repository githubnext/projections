{
  "name": "acme",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "acme",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/admin": {
      "name": "@acme/admin",
      "version": "1.0.0",
      "dependencies": {
        "react": "^19.0.0",
        "@acme/ui": "*"
      }
    },
    "apps/web": {
      "name": "@acme/web",
      "version": "1.0.0",
      "dependencies": {
        "react": "^19.0.0",
        "date-fns": "^3.6.0",
        "@acme/ui": "*",
        "@acme/icons": "*"
      }
    },
    "node_modules/@acme/admin": {
      "resolved": "apps/admin",
      "link": true
    },
    "node_modules/@acme/icons": {
      "resolved": "packages/icons",
      "link": true
    },
    "node_modules/@acme/ui": {
      "resolved": "packages/ui",
      "link": true
    },
    "node_modules/@acme/web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/clsx": {
      "version": "2.1.1",
      "resolved": "https://registry.npmjs.org/clsx/-/clsx-2.1.1.tgz",
      "license": "MIT"
    },
    "node_modules/date-fns": {
      "version": "3.6.0",
      "resolved": "https://registry.npmjs.org/date-fns/-/date-fns-3.6.0.tgz",
      "license": "MIT"
    },
    "node_modules/react": {
      "version": "19.0.0",
      "resolved": "https://registry.npmjs.org/react/-/react-19.0.0.tgz",
      "license": "MIT"
    },
    "packages/icons": {
      "name": "@acme/icons",
      "version": "1.0.0",
      "dependencies": {
        "react": "^19.0.0"
      }
    },
    "packages/ui": {
      "name": "@acme/ui",
      "version": "1.0.0",
      "dependencies": {
        "react": "^19.0.0",
        "clsx": "^2.1.1",
        "@acme/icons": "*"
      }
    }
  }
}