{
  "name": "acme",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "acme",
      "workspaces": [
        "apps/*",
        "packages/*"
      ]
    },
    "apps/admin": {
      "name": "@acme/admin",
      "version": "1.0.0",
      "dependencies": {
        "react": "^18.3.1",
        "@acme/ui": "*"
      }
    },
    "apps/web": {
      "name": "@acme/web",
      "version": "1.0.0",
      "dependencies": {
        "react": "^18.3.1",
        "moment": "^2.30.1",
        "@acme/ui": "*"
      }
    },
    "node_modules/@acme/admin": {
      "resolved": "apps/admin",
      "link": true
    },
    "node_modules/@acme/ui": {
      "resolved": "packages/ui",
      "link": true
    },
    "node_modules/@acme/web": {
      "resolved": "apps/web",
      "link": true
    },
    "node_modules/classnames": {
      "version": "2.5.1",
      "resolved": "https://registry.npmjs.org/classnames/-/classnames-2.5.1.tgz",
      "license": "MIT"
    },
    "node_modules/moment": {
      "version": "2.30.1",
      "resolved": "https://registry.npmjs.org/moment/-/moment-2.30.1.tgz",
      "license": "MIT"
    },
    "node_modules/react": {
      "version": "18.3.1",
      "resolved": "https://registry.npmjs.org/react/-/react-18.3.1.tgz",
      "license": "MIT"
    },
    "packages/ui": {
      "name": "@acme/ui",
      "version": "1.0.0",
      "dependencies": {
        "react": "^18.3.1",
        "classnames": "^2.5.1"
      }
    }
  }
}