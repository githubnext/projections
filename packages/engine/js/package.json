{
  "name": "@githubnext/projections-engine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "One Rust engine and the default comparator for native and browser Projections",
  "files": [
    "dist",
    "artifacts",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "import": "./dist/browser.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js"
    },
    "./artifacts": {
      "types": "./dist/artifacts/index.d.ts",
      "import": "./dist/artifacts/index.js"
    },
    "./engine.wasm": "./artifacts/engine.wasm",
    "./default-comparator.wasm": "./artifacts/default-comparator.wasm"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:rust": "cargo test --manifest-path ../../../Cargo.toml",
    "test:browser": "node scripts/browser-test.mjs && node scripts/artifacts-browser-test.mjs",
    "measure": "node scripts/measure.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@githubnext/projections-schemas": "0.1.0"
  },
  "devDependencies": {
    "@exodus/schemasafe": "^1.3.0",
    "ajv": "^8.17.1",
    "playwright": "^1.56.1"
  },
  "engines": {
    "node": ">=26.12.1"
  }
}
