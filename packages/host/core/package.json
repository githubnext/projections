{
  "name": "@githubnext/projections-host",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Browser host for Projections: sandboxed renderer frames, playback, selection, in-browser comparison and built-in table and text views",
  "files": [
    "README.md",
    "build",
    "dist",
    "dist/ui.css",
    "src/ui/components/LICENSE.shadcn.txt"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/ui.css",
    "./build": {
      "types": "./build/collect-renderers.d.mts",
      "import": "./build/collect-renderers.mjs"
    },
    "./build/ui-notices": {
      "types": "./build/ui-notices.d.mts",
      "import": "./build/ui-notices.mjs"
    },
    "./build/browser-notices": {
      "types": "./build/browser-notices.d.mts",
      "import": "./build/browser-notices.mjs"
    },
    "./ui.css": "./dist/ui.css",
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./ui/components": {
      "types": "./dist/ui/components/index.d.ts",
      "import": "./dist/ui/components/index.js"
    }
  },
  "dependencies": {
    "@githubnext/projections-machine": "0.2.0",
    "@githubnext/projections-renderer-sdk": "0.2.0",
    "@githubnext/projections-schemas": "0.2.0",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-toolbar": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.62.0",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@githubnext/projections-engine": "0.2.0",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "postcss": "^8.5.32",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-ui-css.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p browser/tsconfig.json",
    "test": "node --test test/*.test.mjs",
    "test:browser": "npm run build --workspace @githubnext/projections-storybook && playwright test"
  }
}
