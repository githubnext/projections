{
  "name": "@githubnext/projections-inspector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "The mountable Projections Inspector UI: hosts (the VS Code extension, the CLI's headless pages) mount it over a transport",
  "files": [
    "dist",
    "src/styles.css",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./mount": {
      "types": "./dist/ui/mount.d.ts",
      "import": "./dist/ui/mount.js"
    },
    "./transport": {
      "types": "./dist/ui/transport.d.ts",
      "import": "./dist/ui/transport.js"
    },
    "./viewer": {
      "types": "./dist/ui/viewer/index.d.ts",
      "import": "./dist/ui/viewer/index.js"
    },
    "./bundle/*": "./dist/client/*"
  },
  "dependencies": {
    "@githubnext/projections-comparator-runtime": "0.1.0",
    "@githubnext/projections-engine": "0.1.0",
    "@githubnext/projections-host": "0.1.0",
    "@githubnext/projections-renderer-sdk": "0.1.0",
    "@githubnext/projections-renderer-testing": "0.1.0",
    "@githubnext/projections-schemas": "0.1.0",
    "lucide-react": "^1.62.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@githubnext/projections-renderer-api": "0.1.0",
    "@githubnext/projections-renderer-code-statistics": "0.1.0",
    "@githubnext/projections-renderer-database": "0.1.0",
    "@githubnext/projections-renderer-dependency-injection": "0.1.0",
    "@githubnext/projections-renderer-file-packing": "0.1.0",
    "@githubnext/projections-renderer-graph": "0.1.0",
    "@githubnext/projections-renderer-runtime-policy": "0.1.0",
    "@githubnext/projections-renderer-text-diff": "0.1.0",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "vite": "^7.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "build:client": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json",
    "test": "node --test test/*.test.mjs",
    "test:browser": "playwright test"
  },
  "engines": {
    "node": ">=26.12.1"
  }
}
