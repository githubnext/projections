{
  "name": "@githubnext/projections-renderer-agentic-workflows",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Built-in Projections agentic workflows renderer: each workflow's triggers, scope, outputs and budgets, and the direction each change moves them",
  "files": [
    "dist",
    "README.md",
    "scenarios.json"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "projections": {
    "renderer": "dist"
  },
  "dependencies": {
    "@githubnext/projections-renderer-kit": "0.2.0",
    "@githubnext/projections-renderer-sdk": "0.2.0",
    "@githubnext/projections-schemas": "0.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@githubnext/projections-comparator-runtime": "0.2.0",
    "@githubnext/projections-engine": "0.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "vite": "^7.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p browser/tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test test/*.test.mjs"
  }
}
