    {
      "id": "prisma-shop",
      "title": "Prisma: addresses and order states",
      "description": "A Prisma storefront schema read by prisma-schema: an Address table arrives with a foreign key to Customer, orders gain a shipping-address foreign key and a customer/status index, product titles become VARCHAR(200) and prices BigInt, the unique constraint on customer phone numbers is dropped, and the OrderStatus enum gains CANCELLED and REFUNDED.",
      "before": "fixtures/prisma-shop-before.json",
      "after": "fixtures/prisma-shop-after.json"
    },
    {
      "id": "django-library",
      "title": "Django: publishers and loans",
      "description": "A Django library app read by django-schema from its model registry: a Publisher table arrives and books gain a nullable foreign key to it, author names widen to 200 characters, page counts become a PositiveIntegerField and the check constraint it replaces is dropped, and loans gain a member/due-date index.",
      "before": "fixtures/django-library-before.json",
      "after": "fixtures/django-library-after.json"
    },
    {
      "id": "prisma-licensing",
      "title": "Prisma: tables that reference each other",
      "description": "Users, licenses and stores reference each other (a user's current license and the license's user, a store's owner and the user's home store), as licensing schemas often do; a refunds table arrives. Every link still runs between ranks or in the left lanes, never behind a card.",
      "before": "fixtures/prisma-licensing-before.json",
      "after": "fixtures/prisma-licensing-after.json"
    },
    {
      "id": "extensions",
      "title": "Postgres extensions beside the tables",
      "description": "Extensions are entities of their own, drawn as tags below the tables: citext is upgraded and pg_trgm arrives.",
      "before": "fixtures/extensions-before.json",
      "after": "fixtures/extensions-after.json"
    },
    {
      "id": "organizations",
      "title": "Organizations arrive",
      "description": "A new Organizations table that four tables reference: each foreign-key column arrives in its own step and moves into the key group once its principal table exists.",
      "before": "fixtures/invoicing-before.json",
      "after": "fixtures/invoicing-after.json"
    },
