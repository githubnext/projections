{
  "name": "@githubnext/projections-renderer-dependency-injection",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Built-in Projections dependency-injection renderer: composed registrations with their lifetime marks, staged by the comparison's steps",
  "files": [
    "dist",
    "README.md",
    "scenarios.json",
    "test/fixtures/*.json"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./fixtures/*": "./test/fixtures/*"
  },
  "projections": {
    "renderer": "dist"
  },
  "dependencies": {
    "@githubnext/projections-renderer-kit": "0.2.0",
    "@githubnext/projections-renderer-sdk": "0.2.0",
    "@githubnext/projections-schemas": "0.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@githubnext/projections-engine": "0.2.0",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "vite": "^7.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "test": "tsc -p tsconfig.test.json && node --test test/*.test.mjs"
  }
}
