{
  "name": "@githubnext/projections-renderer-file-packing",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Built-in Projections file-packing renderer: files as circles sized by their bytes, packed inside their folders",
  "files": [
    "dist",
    "README.md",
    "scenarios.json",
    "fixtures/*.json"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "projections": {
    "renderer": "dist"
  },
  "dependencies": {
    "@githubnext/projections-renderer-kit": "0.2.0",
    "@githubnext/projections-renderer-sdk": "0.2.0",
    "@githubnext/projections-schemas": "0.2.0",
    "d3-hierarchy": "^3.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@githubnext/projections-engine": "0.2.0",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "vite": "^7.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "test": "tsc -p tsconfig.test.json && node --test test/*.test.mjs"
  }
}
