    {
      "id": "service-platform",
      "title": "Service platform",
      "description": "Payments split out of orders, a cache arrives and legacy billing retires, step by step.",
      "renderer": "graph",
      "before": "fixtures/service-platform-before.json",
      "after": "fixtures/service-platform-after.json"
    },
    {
      "id": "service-platform-priority",
      "title": "Service platform, payments first (custom order)",
      "description": "The priority-order example comparator presents the step that adds payments (with fraud and the cache) first; legacy billing retires afterwards.",
      "renderer": "graph",
      "before": "fixtures/service-platform-before.json",
      "after": "fixtures/service-platform-after.json",
      "comparator": {
        "file": "../../../examples/comparators/priority-order/priority-order.comparator.yaml",
        "options": {
          "priority": ["payments"]
        }
      }
    },
    {
      "id": "test-timings",
      "title": "Test timings with volatile durations",
      "description": "Durations are declared volatile: parse and emit vary within tolerance and stay unchanged and neutral, load slows beyond it (modified, marked volatile), save fails and an export test arrives.",
      "renderer": "graph",
      "before": "fixtures/test-timings-before.json",
      "after": "fixtures/test-timings-after.json",
      "comparator": {
        "file": "../../../examples/comparators/test-timings/test-timings.comparator.yaml"
      }
    },
    {
      "id": "class-summaries",
      "title": "Class summaries, generated by a model",
      "description": "Summaries are generated values, judged by their basis: Cart is reworded from the same inputs (unchanged, counted as regenerated), Orders changed so its summary was regenerated, and Invoices was regenerated only because the model changed (modified, gathered last by the model-upgrades comparator).",
      "renderer": "graph",
      "before": "fixtures/class-summaries-before.json",
      "after": "fixtures/class-summaries-after.json",
      "comparator": {
        "file": "../../../examples/comparators/model-upgrades/model-upgrades.comparator.yaml"
      }
    },
