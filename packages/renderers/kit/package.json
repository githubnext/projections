{
  "name": "@githubnext/projections-renderer-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Shared kit for built-in Projections renderers: a framework-free entry (comparison model, step timeline, staged graph transitions, ELK graph layout, diff mode, status and colors), a React entry (the renderer shell, graph canvas and presentation components) and plain CSS",
  "files": [
    "dist",
    "base.css",
    "react.css",
    "styles",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./base.css": "./base.css",
    "./react.css": "./react.css",
    "./package.json": "./package.json"
  },
  "imports": {
    "#layout-engine": {
      "node": "./dist/engine/node.js",
      "default": "./dist/engine/browser.js"
    }
  },
  "sideEffects": [
    "*.css"
  ],
  "dependencies": {
    "@githubnext/projections-renderer-sdk": "0.1.0",
    "@githubnext/projections-schemas": "0.1.0",
    "elkjs": "^0.12.1",
    "lucide": "^1.64.0",
    "perfect-arrows": "^0.3.7"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@githubnext/projections-engine": "0.1.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.browser.json",
    "test": "node --test test/*.test.mjs"
  }
}
