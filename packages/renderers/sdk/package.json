{
  "name": "@githubnext/projections-renderer-sdk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Renderer frame protocol client, React binding, bundle build helper and deterministic presentation state for Projections renderers",
  "files": [
    "dist",
    "build",
    "icons.css",
    "vendor",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "import": "./dist/protocol.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./interactions": {
      "types": "./dist/interactions.d.ts",
      "import": "./dist/interactions.js"
    },
    "./rings": {
      "types": "./dist/rings.d.ts",
      "import": "./dist/rings.js"
    },
    "./presentation": {
      "types": "./dist/presentation.d.ts",
      "import": "./dist/presentation.js"
    },
    "./languages": {
      "types": "./dist/languages.d.ts",
      "import": "./dist/languages.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./notices": {
      "types": "./build/notices.d.mts",
      "import": "./build/notices.mjs"
    },
    "./icons.css": "./icons.css",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@githubnext/projections-schemas": "0.1.0",
    "lucide": "^1.64.0"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "vite": "^7.1.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "react": "^19.1.0",
    "vite": "^7.1.0",
    "yaml": "^2.8.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  }
}
