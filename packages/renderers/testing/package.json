{
  "name": "@githubnext/projections-renderer-testing",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Test renderer bundles against scenario fixtures in the real Projections host: the Inspector's built-in renderer checks and Playwright helpers",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright/index.d.ts",
      "import": "./dist/playwright/index.js"
    },
    "./workbench": {
      "types": "./dist/playwright/workbench.d.ts",
      "import": "./dist/playwright/workbench.js"
    },
    "./probe": "./dist/probe.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@githubnext/projections-renderer-sdk": "0.2.0",
    "@githubnext/projections-schemas": "0.2.0"
  },
  "peerDependencies": {
    "@playwright/test": "^1.55.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "vite": "^7.1.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-probe.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=26.12.1"
  }
}
