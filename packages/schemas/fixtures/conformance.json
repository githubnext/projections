          {"id": "edge:deep", "collection": "relationships", "before": ["edge:deep"], "after": [], "status": "removed", "correspondence": "none", "context": {"before": ["deep", "mid"], "after": []}},
          {"id": "edge:shallow", "collection": "relationships", "before": ["edge:shallow"], "after": [], "status": "removed", "correspondence": "none", "context": {"before": ["root", "shallow"], "after": []}}
