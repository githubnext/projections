        {"id": "edge:mid", "kind": "dependency", "from": "root", "to": "mid"}
      ]},
      "expected": {"protocolVersion": 0,
        "changes": [
          {"id": "deep", "collection": "entities", "before": ["deep"], "after": [], "status": "removed", "correspondence": "none"},
