{
  "version": 0,
  "description": "The extractor helpers' shared behaviour: the Python module (packages/cli/python/projections) and @githubnext/projections/extractor (packages/sdk/src/extractor) read each request, answer each accessor and write each extraction alike, failing with the same messages. A case reads `stdin` (or the text `stdinText`) as the request, then either reads the `accessors` named (JavaScript's names; Python's in snake_case) or calls result() with `result`; it expects their values or the extraction (`expected`), or an `error` message (or one starting with `errorStartsWith`). Paths are written with `/`, which Windows separators are compared as.",
  "cases": [
    {
      "id": "accessors-at-the-root",
      "stdin": {
        "protocolVersion": 0,
        "projection": {"id":"flags","definition":{"id":"flags","inputs":{"file":"flags.yaml"}}},
        "repository": {
          "mode": "in-place",
          "root": "/repo",
          "project": "",
          "revision": {"kind":"commit","ref":"HEAD","commit":"0123456789abcdef0123456789abcdef01234567","dirty":false},
          "checkout": "/repo"
        },
        "capabilities": {"trusted":true,"network":false},
        "upstream": {"crates":{"protocolVersion":0,"schema":"graph/v0","entities":[],"relationships":[]}}
      },
      "accessors": ["project","repositoryRoot","root","checkout","id","definition","inputs","upstream","trusted"],
      "expected": {
        "project": "",
        "repositoryRoot": "/repo",
        "root": "/repo",
        "checkout": "/repo",
        "id": "flags",
        "definition": {"id":"flags","inputs":{"file":"flags.yaml"}},
        "inputs": {"file":"flags.yaml"},
        "upstream": {"crates":{"protocolVersion":0,"schema":"graph/v0","entities":[],"relationships":[]}},
        "trusted": true
      }
    },
    {
      "id": "accessors-in-a-nested-project",
      "stdin": {
        "protocolVersion": 0,
        "projection": {"id":"flags","definition":{"id":"flags","inputs":{"file":"flags.yaml"}}},
        "repository": {
          "mode": "materialized",
          "root": "/tmp/revision",
          "project": "packages/app",
          "revision": {"kind":"commit","ref":"HEAD","commit":"0123456789abcdef0123456789abcdef01234567","dirty":false},
          "checkout": "/repo"
        },
        "capabilities": {"trusted":true,"network":false}
      },
      "accessors": ["project","repositoryRoot","root","checkout","id","definition","inputs","upstream","trusted"],
      "expected": {
        "project": "packages/app",
        "repositoryRoot": "/tmp/revision",
        "root": "/tmp/revision/packages/app",
        "checkout": "/repo/packages/app",
        "id": "flags",
        "definition": {"id":"flags","inputs":{"file":"flags.yaml"}},
        "inputs": {"file":"flags.yaml"},
        "upstream": {},
        "trusted": true
      }
    },
