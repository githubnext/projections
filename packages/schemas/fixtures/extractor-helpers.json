      "accessors": ["project","repositoryRoot","root","checkout","id","definition","inputs","upstream","trusted"],
      "expected": {
        "project": "",
        "repositoryRoot": "/repo",
        "root": "/repo",
        "checkout": null,
        "id": "flags",
        "definition": {"id":"flags"},
        "inputs": {},
        "upstream": {},
        "trusted": false
      }
    },
