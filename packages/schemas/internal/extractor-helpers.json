{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Extractor helper cases (internal)",
  "description": "Generated from packages/schemas/src/repository; internal and unversioned, never published. Validates packages/schemas/fixtures/extractor-helpers.json (see .dollarlint.toml).",
  "type": "object",
  "required": ["version", "description", "cases"],
  "properties": {
    "version": {"type": "number", "const": 0},
    "description": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "cases": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "type": "object",
            "required": ["id"],
            "properties": {"id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"}}
          },
          {
            "anyOf": [
              {"type": "object", "required": ["stdin"], "properties": {"stdin": {}}},
              {
                "type": "object",
                "required": ["stdinText"],
                "properties": {"stdinText": {"type": "string"}}
              }
            ]
          },
          {
            "anyOf": [
              {
                "type": "object",
                "required": ["accessors"],
                "properties": {
                  "accessors": {
                    "type": "array",
                    "items": {"type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9]*$"},
                    "minItems": 1
                  }
                }
              },
              {"type": "object", "required": ["result"], "properties": {"result": {}}}
            ]
          },
          {
            "anyOf": [
              {"type": "object", "required": ["expected"], "properties": {"expected": {}}},
              {
                "type": "object",
                "required": ["error"],
                "properties": {"error": {"type": "string", "minLength": 1, "pattern": "\\S"}}
              },
              {
                "type": "object",
                "required": ["errorStartsWith"],
                "properties": {"errorStartsWith": {"type": "string", "minLength": 1, "pattern": "\\S"}}
              }
            ]
          }
        ],
        "unevaluatedProperties": false
      },
      "minItems": 1
    }
  },
  "additionalProperties": false
}
