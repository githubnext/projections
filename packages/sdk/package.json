{
  "name": "@githubnext/projections",
  "version": "0.2.0",
  "description": "Write Projections renderers: the frame protocol client, the renderer kit (framework-free, React and CSS), the Vite build, renderer checks and the document types; and helpers for extractors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/githubnext/projections.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/githubnext/projections/blob/main/packages/sdk/README.md",
  "bugs": "https://github.com/githubnext/projections/issues",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "keywords": [
    "projections",
    "renderer",
    "code-review",
    "visualization"
  ],
  "bin": {
    "projections-renderer-workbench": "./dist/workbench.js"
  },
  "exports": {
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "import": "./dist/renderer.js"
    },
    "./renderer/react": {
      "types": "./dist/renderer-react.d.ts",
      "import": "./dist/renderer-react.js"
    },
    "./renderer/icons.css": "./dist/renderer/icons.css",
    "./kit": {
      "types": "./dist/kit.d.ts",
      "import": "./dist/kit.js"
    },
    "./kit/react": {
      "types": "./dist/kit-react.d.ts",
      "import": "./dist/kit-react.js"
    },
    "./kit/base.css": "./dist/kit/base.css",
    "./kit/react.css": "./dist/kit/react.css",
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js"
    },
    "./extractor": {
      "types": "./dist/extractor.d.ts",
      "import": "./dist/extractor.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#layout-engine": {
      "node": "./dist/engine/node.js",
      "default": "./dist/engine/browser.js"
    }
  },
  "files": [
    "dist",
    "vendor"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsdown && node scripts/assets.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p test/tsconfig.json",
    "test": "node scripts/extractor-module.mjs --check && node scripts/check-pack.mjs --contents && node --test test/*.test.ts",
    "generate:extractor": "node scripts/extractor-module.mjs",
    "check:pack": "node scripts/check-pack.mjs"
  },
  "dependencies": {
    "elkjs": "^0.12.1",
    "lucide": "^1.64.0",
    "perfect-arrows": "^0.3.7",
    "typebox": "^1.4.3"
  },
  "peerDependencies": {
    "@playwright/test": "^1.55.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.1.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@githubnext/projections-renderer-kit": "0.2.0",
    "@githubnext/projections-renderer-sdk": "0.2.0",
    "@githubnext/projections-renderer-testing": "0.2.0",
    "@githubnext/projections-schemas": "0.2.0",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsdown": "0.23.4",
    "vite": "^7.1.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
