{
  "$schema": "./ci-plan.cases.schema.json",
  "cases": [
    {
      "name": "Documentation alone runs only the docs job",
      "files": ["README.md", "docs/guides/host.md", "packages/renderers/database/README.md"],
      "expect": {
        "full": false,
        "docsOnly": true,
        "jobs": {
          "docs": true,
          "public-product": [],
          "verus": false,
          "windows": false,
          "windows-node": false,
          "windows-integration": [],
          "package": false,
          "release-config": false,
          "coverage": false,
          "mutants-diff": false,
          "actions-lock": false
        },
        "browser": [],
        "macos": []
      }
    },
    {
      "name": "Markdown a crate embeds or a generator reads or writes runs the Linux checks alone",
      "each": true,
      "files": [
        "docs/reference/cli.md",
        "docs/setup/install.md",
        "docs/agents/ci.md",
        "docs/builtins/renderers/graph.md",
        "packages/cli/src/commands/help/serve.after-help.md"
      ],
      "expect": {
        "docsOnly": false,
        "jobs": {
          "docs": false,
          "public-product": ["ubuntu-latest, checks", "ubuntu-latest, Node", "ubuntu-latest, Rust"],
          "windows": false,
          "windows-node": false,
          "windows-integration": [],
          "package": false,
          "coverage": false
        },
        "browser": [],
        "macos": []
      }
    },
    {
      "name": "One renderer's change runs that renderer's harness tests, the suites that bundle every renderer and the package check, on Linux",
      "files": ["packages/renderers/database/src/styles.css"],
      "expect": {
        "renderers": ["database"],
        "jobs": {
          "public-product": ["ubuntu-latest, checks", "ubuntu-latest, Node", "ubuntu-latest, Rust"],
          "windows": false,
          "windows-node": false,
          "verus": false,
          "mutants-diff": false,
          "package": true
        },
        "browser": [
          "packages/host/core, 1/3",
          "packages/host/core, 2/3",
          "packages/host/core, 3/3",
          "tools/storybook, 1/3",
          "tools/storybook, 2/3",
          "tools/storybook, 3/3",
          "packages/renderers/harness, chromium-desktop (database)",
          "packages/renderers/harness, webkit-desktop (database)",
          "packages/renderers/harness, chromium-mobile (database)",
          "packages/renderers/harness, webkit-mobile (database)",
          "packages/host/inspector, 1/2",
          "packages/host/inspector, 2/2",
          "rest"
        ],
        "macos": ["packages/renderers/harness, webkit-desktop (database)"]
      }
    },
    {
      "name": "A scenario's extraction is its renderer's change",
      "files": ["packages/extractors/tetragon-policies/tests/fixtures/credentials/after.expected.json"],
      "expect": {
        "renderers": ["runtime-policy"],
        "suitesInclude": ["packages/renderers/harness"]
      }
    },
    {
      "name": "The kit every renderer uses runs the whole harness",
      "files": ["packages/renderers/kit/src/index.ts"],
      "expect": {
        "renderers": [],
        "suitesInclude": ["packages/renderers/harness"],
        "harnessJobs": 12
      }
    },
    {
      "name": "An Engine change runs the Rust, Windows, Verus, coverage and mutation jobs and every browser suite",
      "files": ["packages/engine/src/lib.rs"],
      "expect": {
        "full": false,
        "jobs": {
          "public-product": [
            "ubuntu-latest, checks",
            "ubuntu-latest, Node",
            "ubuntu-latest, Rust",
            "macos-latest, Rust",
            "macos-latest, Node"
          ],
          "windows": true,
          "windows-node": true,
          "verus": true,
          "coverage": true,
          "mutants-diff": true,
          "release-config": false
        },
        "allBrowserJobs": true
      }
    },
    {
      "name": "An extractor's change runs the Inspector, which extracts, and the CLI's other suites, but not the renderer harness",
      "files": ["packages/extractors/django-schema/src/lib.rs"],
      "expect": {
        "jobs": {
          "windows": true,
          "mutants-diff": false,
          "verus": false,
          "coverage": false
        },
        "browser": ["packages/host/inspector, 1/2", "packages/host/inspector, 2/2", "rest"],
        "suitesInclude": ["packages/cli", "examples/renderers/minimal"],
        "suitesExclude": ["packages/renderers/harness"]
      }
    },
    {
      "name": "CI, toolchain, lockfile, tooling and rules changes, and unrecognised files, run every job",
      "each": true,
      "files": [
        ".github/workflows/ci.yml",
        ".github/actions/browser/action.yml",
        ".github/ci-rules.json",
        "Cargo.lock",
        "tools/cli/src/cli.ts",
        "tools/cli/README.md",
        "brand/x.svg"
      ],
      "expect": {
        "full": true,
        "allBrowserJobs": true,
        "jobs": {
          "actions-lock": true,
          "release-config": true,
          "mutants-diff": true,
          "docs": true
        }
      }
    },
    {
      "name": "The ci:full label runs everything",
      "files": ["README.md"],
      "labels": ["ci:full", "documentation"],
      "expect": {
        "full": true,
        "docsOnly": false,
        "allBrowserJobs": true
      }
    },
    {
      "name": "Pushes, the nightly run and manual runs run everything",
      "files": [],
      "events": ["push", "schedule", "workflow_dispatch"],
      "expect": {
        "full": true,
        "allBrowserJobs": true,
        "jobs": {
          "actions-lock": true
        }
      }
    },
    {
      "name": "A file a crate's sources read by path is that crate's change, though no manifest says so",
      "each": true,
      "files": ["packages/schemas/fixtures/conformance.json", "packages/schemas/schemas/api/v0.json"],
      "expect": {
        "changedInclude": ["packages/engine"],
        "jobs": {
          "coverage": true,
          "windows": true
        }
      }
    },
    {
      "name": "A file only a crate's tests read runs its suites without changing what depends on it",
      "files": ["packages/schemas/fixtures/conformance.json"],
      "expect": {
        "changedInclude": ["packages/engine"],
        "dependantsExclude": ["packages/comparators/rules"]
      }
    },
    {
      "name": "Any file of a crate is a Rust change, and Markdown test data is not documentation",
      "each": true,
      "files": [
        "packages/extractors/github-agentic-workflows/vendor/gh-aw/fields.json",
        "packages/extractors/github-agentic-workflows/tests/fixtures/public/.github/workflows/firewall.md"
      ],
      "expect": {
        "docsOnly": false,
        "jobs": {
          "windows": true,
          "package": true
        }
      }
    },
    {
      "name": "The default comparator, which packages/engine/js's build bundles, reaches it",
      "files": ["packages/comparators/default/src/lib.rs"],
      "expect": {
        "dependantsInclude": ["packages/engine/js"],
        "suitesInclude": ["packages/engine/js"]
      }
    },
    {
      "name": "The rules crate, which packages/comparators/runtime/js's build builds, reaches it",
      "files": ["packages/comparators/rules/src/lib.rs"],
      "expect": {
        "dependantsInclude": ["packages/comparators/runtime/js"],
        "suitesInclude": ["packages/comparators/runtime/js"]
      }
    },
    {
      "name": "The package check runs for what the CLI serves",
      "files": ["packages/host/inspector/src/app/activity.tsx"],
      "expect": {
        "jobs": {
          "package": true
        }
      }
    },
    {
      "name": "Release configuration runs the release check alone",
      "files": ["dist-workspace.toml"],
      "expect": {
        "full": false,
        "jobs": {
          "release-config": true,
          "public-product": ["ubuntu-latest, checks", "ubuntu-latest, Node", "ubuntu-latest, Rust"]
        },
        "browser": []
      }
    },
    {
      "name": "The GitHub Action's definition runs it on every platform",
      "files": ["action.yml"],
      "expect": {
        "jobs": {
          "public-product": [
            "ubuntu-latest, checks",
            "ubuntu-latest, Node",
            "ubuntu-latest, Rust",
            "macos-latest, Rust",
            "macos-latest, Node"
          ],
          "windows-node": true,
          "windows-integration": ["browser", "VS Code"]
        }
      }
    },
    {
      "name": "Hand-written documentation that crates embed and generators read, with plain documentation, runs the Linux checks alone",
      "files": [
        "CONTRIBUTING.md",
        "docs/agents/ci.md",
        "docs/agents/explore.md",
        "docs/builtins/extractors/prisma-schema.md",
        "packages/cli/README.md"
      ],
      "expect": {
        "jobs": {
          "docs": false,
          "public-product": ["ubuntu-latest, checks", "ubuntu-latest, Node", "ubuntu-latest, Rust"],
          "windows": false,
          "windows-node": false,
          "package": false
        },
        "browser": []
      }
    },
    {
      "name": "A template a crate embeds is still that crate's change",
      "files": ["packages/cli/templates/SKILL.md"],
      "expect": {
        "jobs": {
          "windows": true
        },
        "changedInclude": ["packages/cli"]
      }
    },
    {
      "name": "macOS runs for Rust, the GitHub Action and the CLI's packaging scripts",
      "each": true,
      "files": [
        "packages/engine/src/lib.rs",
        "packages/extractors/django-schema/Cargo.toml",
        "action.yml",
        "packages/cli/scripts/build.mjs",
        "Cargo.lock"
      ],
      "expect": {
        "productIncludes": ["macos-latest, Rust", "macos-latest, Node"]
      }
    },
    {
      "name": "macOS doesn't run for other code, though Windows does",
      "each": true,
      "files": [
        "packages/sdk/src/extractor.ts",
        "packages/cli/src/headless.js",
        "packages/extractors/github-agentic-workflows/vendor/gh-aw/fields.json"
      ],
      "expect": {
        "jobs": {
          "public-product": ["ubuntu-latest, checks", "ubuntu-latest, Node", "ubuntu-latest, Rust"],
          "windows-node": true
        }
      }
    },
    {
      "name": "A CLI change runs the Inspector, which explores through it, but not the renderer harness",
      "files": ["packages/cli/src/main.rs"],
      "expect": {
        "suitesInclude": ["packages/host/inspector", "packages/cli"],
        "suitesExclude": ["packages/renderers/harness"],
        "macos": []
      }
    },
    {
      "name": "The renderer SDK, the schemas and the Engine's Wasm build run the whole harness",
      "each": true,
      "files": ["packages/renderers/sdk/src/protocol.ts", "packages/schemas/src/domains.ts", "packages/engine/js/src/index.ts"],
      "expect": {
        "renderers": [],
        "harnessJobs": 12
      }
    },
    {
      "name": "The Inspector and host the harness draws renderers in run it",
      "each": true,
      "files": ["packages/host/core/src/frame.ts", "packages/host/inspector/src/fixtures/stage.ts"],
      "expect": {
        "suitesInclude": ["packages/renderers/harness"],
        "renderers": []
      }
    },
    {
      "name": "Documentation a crate or generator reads is checks, including files that don't exist yet",
      "each": true,
      "files": [
        "packages/extractors/django-schema/NOTES.md",
        "docs/reference/new-page.md",
        "docs/agents/new-prompt.md",
        "packages/cli/src/commands/help/new.after-help.md"
      ],
      "expect": {
        "classes": ["checks"],
        "docsOnly": false,
        "jobs": {
          "docs": false,
          "public-product": ["ubuntu-latest, checks", "ubuntu-latest, Node", "ubuntu-latest, Rust"],
          "windows": false,
          "package": false
        },
        "browser": []
      }
    },
    {
      "name": "A file outside every workspace that only a generator reads or writes is code that touches nothing: the Linux checks",
      "each": true,
      "files": ["brand/projections-mark.svg", "notices/notices.json"],
      "expect": {
        "classes": ["code"],
        "full": false,
        "jobs": {
          "public-product": ["ubuntu-latest, checks", "ubuntu-latest, Node", "ubuntu-latest, Rust"],
          "windows": false,
          "package": false
        },
        "browser": []
      }
    },
    {
      "name": "LICENSE, which the CLI embeds, is the CLI's change",
      "files": ["LICENSE"],
      "expect": {
        "classes": ["code"],
        "changedInclude": ["packages/cli"],
        "jobs": {
          "windows": true,
          "package": true
        },
        "suitesInclude": ["packages/host/inspector"]
      }
    },
    {
      "name": "A file only the CLI's tests read runs the CLI's suites, but reaches nothing through it",
      "files": ["examples/comparators/priority-order/fixtures/after.json"],
      "expect": {
        "classes": ["code"],
        "changedInclude": ["packages/cli"],
        "dependantsExclude": ["packages/integrations/github-action"],
        "suitesInclude": ["packages/cli"]
      }
    },
    {
      "name": "Mutation testing leaves out the files .cargo/mutants.toml excludes",
      "files": ["packages/engine/src/wasm.rs"],
      "expect": {
        "jobs": {
          "mutants-diff": false,
          "verus": true,
          "coverage": true
        }
      }
    }
  ]
}
